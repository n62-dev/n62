+  static void solve_comprim(vecteur & v,GIAC_CONTEXT){
+    vecteur w;
+    for (unsigned i=0;i<v.size();++i){
+      bool dup=false;
+      for (unsigned j=0;j<w.size() && !dup;++j)
+	dup=solve_same_root(w[j],v[i],contextptr);
+      if (!dup)
+	w.push_back(v[i]);
+    }
+    v=w;
+  }
