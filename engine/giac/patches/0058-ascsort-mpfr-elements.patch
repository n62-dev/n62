+  // G786: ascsort's sort of a row that holds a real float that is no double (an MPFR value above 14 digits, a _FLOAT_): each
+  // element is kept and sorted by its value (MPFR compared exactly, mpfr_cmp and mpfr_cmp_d); an element with no real float
+  // value (a complex, a NaN) is a double 0, as before.
+  struct ascsort_elem {
+    gen key; // a _DOUBLE_ or a _REAL that is no NaN
+    gen val; // the element as written back
+  };
+  static bool ascsort_less(const ascsort_elem & A,const ascsort_elem & B){
+    const gen & a=A.key, & b=B.key;
+#ifdef HAVE_LIBMPFR
+    if (a.type==_REAL && b.type==_REAL)
+      return mpfr_cmp(a._REALptr->inf,b._REALptr->inf)<0;
+    if (a.type==_REAL)
+      return mpfr_cmp_d(a._REALptr->inf,b._DOUBLE_val)<0;
+    if (b.type==_REAL)
+      return mpfr_cmp_d(b._REALptr->inf,a._DOUBLE_val)>0;
+#endif
+    return a._DOUBLE_val<b._DOUBLE_val;
+  }
+  static void ascsort_floats(vecteur & v,const vector<gen> & vf){
+    int n=int(vf.size());
+    vector<ascsort_elem> w(n);
+    for (int j=0;j<n;++j){
+      const gen & t=vf[j];
+      w[j].key=0.0;
+      w[j].val=0.0;
+      if (t.type==_DOUBLE_){
+	if (t._DOUBLE_val==t._DOUBLE_val)
+	  w[j].key=w[j].val=t;
+      }
+#ifdef HAVE_LIBMPFR
+      else if (t.type==_REAL){
+	if (!mpfr_nan_p(t._REALptr->inf))
+	  w[j].key=w[j].val=t;
+      }
+#endif
+      else if (t.type==_FLOAT_){
+	gen d=evalf_double(t,1,context0);
+	if (d.type==_DOUBLE_ && d._DOUBLE_val==d._DOUBLE_val){
+	  w[j].key=d;
+	  w[j].val=t;
+	}
+      }
+    }
+    std::stable_sort(w.begin(),w.end(),ascsort_less);
+    for (int j=0;j<n;++j)
+      v[j]=w[j].val;
+  }
