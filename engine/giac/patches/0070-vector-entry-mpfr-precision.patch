+  // N62 (G804): accurate_evalf leaves a product or a quotient of a symbolic constant symbolic (pi/10^11 becomes
+  // pi_mpfr*1e-11, no number), and the callers then went on with has_evalf's value at the context's Digits. Vector and
+  // matrix arithmetic (addvecteur, multvecteur, mmult) calls them with context0, whose Digits is the default, so such an
+  // entry beside an MPFR float was a double: [[pi]]/10^11+evalf([[30000000]]) = [[30000000.0]] at Digits 30 (the scalar
+  // sum was right), 10^14*[[pi]]+evalf([[2]]) lost 10^14*pi's digits past the 16th. accurate_evalf_value takes the
+  // value at the MPFR operand's precision (nbits), whatever the context's Digits; a vector keeps accurate_evalf's result
+  // (G802: a vector not fully numeric goes on as before, entry by entry), and a value with no float stays as it was.
+  gen accurate_evalf_value(const gen & g,int nbits,GIAC_CONTEXT){
+    gen res=accurate_evalf(g,nbits);
+    if (g.type==_VECT || accurate_evalf_is_number(res))
+      return res;
+    int save=decimal_digits(contextptr);
+    set_decimal_digits(bits2digits(nbits),contextptr);
+    gen v;
+    bool ok=false;
+#ifndef NO_STDEXCEPT
+    try {
+#endif
+      ok=has_evalf(g,v,1,contextptr);
+#ifndef NO_STDEXCEPT
+    } catch (...) {
+      set_decimal_digits(save,contextptr);
+      throw;
+    }
+#endif
+    set_decimal_digits(save,contextptr);
+    if (ok && v.is_approx())
+      return v;
+    return res;
+  }
