# Upstream: giac 2.1.0 moyal.cc. A list as the last argument x of a cdf, an icdf or a UTP* gave no values: the formulas build around the list (normald_cdf(0,1,list[1/2,3/2]) = (erf(list[sqrt(2)/4,3*sqrt(2)/4])+1)/2, chisquare_cdf(2,list[1,2]) = 1-UTPC(2,list[1,2]), fisher_cdf(2,3,list[1,2]) = Beta(1,3/2,list[2/5,4/7],1), poisson_cdf(2,list[1,2]) = ugamma(list[2,3],2.0,1)), and the outer call does not map, or Giac refuses the call (binomial_cdf, chisquare_icdf, fisher_icdf, betad_icdf, gammad_icdf, poisson_icdf) or returns the call (UTPC, UTPF, UTPT, binomial_icdf, student_icdf) or loses the parameters (normald_icdf(0,1,list[..]) = normal_icdf(list[..])). Now each of these maps the list over the scalar call (patch 0007 does the same for the densities with apply2nd); the result has the list's type.
# Changed by Pascaline contributors, 2026-11-09
--- a/src/moyal.cc
+++ b/src/moyal.cc
@@ -271,1 +271,25 @@
-  gen _UTPN(const gen & args,GIAC_CONTEXT){
+  // N62 patch 0038 (G169): a list as the last argument of a cdf, an icdf or a UTP* is one value per element, as patch 0007
+  // does for the densities (apply2nd): each element goes through the scalar call, so its form and its branch are the
+  // scalar's. Giac's formulas took the list inside erf, UTPC, ugamma or Beta, and that outer call does not map:
+  // normald_cdf(0,1,list[1/2,3/2]) was (erf(list[...])+1)/2. Only a sequence of at least two arguments: one list alone is Giac's
+  // argument list (normald_cdf([0.5,1.5]) is normald_cdf(0.5,1.5)).
+  static bool pas_list_x(const gen & g){
+    return g.type==_VECT && g.subtype==_SEQ__VECT && g._VECTptr->size()>=2 && g._VECTptr->back().type==_VECT;
+  }
+  static gen pas_map_x(const gen & g,gen (*f)(const gen &,GIAC_CONTEXT),GIAC_CONTEXT){
+    vecteur args(*g._VECTptr),res;
+    gen L=args.back();
+    res.reserve(L._VECTptr->size());
+    vecteur::const_iterator it=L._VECTptr->begin(),itend=L._VECTptr->end();
+    for (;it!=itend;++it){
+      args.back()=*it;
+      gen r=f(gen(args,_SEQ__VECT),contextptr);
+      if (is_undef(r))
+	return r;
+      res.push_back(r);
+    }
+    return gen(res,L.subtype);
+  }
+
+  gen _UTPN(const gen & args,GIAC_CONTEXT){
+    if (pas_list_x(args)) return pas_map_x(args,_UTPN,contextptr);
