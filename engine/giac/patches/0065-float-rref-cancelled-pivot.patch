+  // pivot of 1e-40 at Digits 40 (rank(evalf([[1,2,3],[4,5,6],[7,8,9]])) = 0, rref the identity, ker []). Only a sum
+  // whose parts are MPFR (a real, or a complex of reals) is tested; every other sum is returned as it is.
+#if defined HAVE_LIBMPFR && !defined BF2GMP_H
+  static bool lc_real_exp(const gen & g,long & e,bool & any){
+    if (g.type==_REAL){
+      if (!mpfr_number_p(g._REALptr->inf))
+	return false;
+      if (!mpfr_zero_p(g._REALptr->inf)){
+	long ge=mpfr_get_exp(g._REALptr->inf);
+	if (!any || ge>e) e=ge;
+	any=true;
+      }
+      return true;
+    }
+    if (g.type==_CPLX)
+      return lc_real_exp(*g._CPLXptr,e,any) && lc_real_exp(*(g._CPLXptr+1),e,any);
+    return is_exactly_zero(g);
+  }
+  static bool lc_part_cancelled(const gen & p,long e){
+    if (p.type!=_REAL)
+      return is_exactly_zero(p);
+    if (mpfr_zero_p(p._REALptr->inf))
+      return true;
+    return mpfr_get_exp(p._REALptr->inf)<=e-long(mpfr_get_prec(p._REALptr->inf))+12;
+  }
+#endif
+  static gen lc_sum(const gen & t1,const gen & t2){
+    gen s=t1+t2;
+#if defined HAVE_LIBMPFR && !defined BF2GMP_H
+    if (s.type!=_REAL && !(s.type==_CPLX && (s._CPLXptr->type==_REAL || (s._CPLXptr+1)->type==_REAL)))
+      return s;
+    long e=0; bool any=false;
+    if (!lc_real_exp(t1,e,any) || !lc_real_exp(t2,e,any) || !any)
+      return s;
+    if (s.type==_REAL ? lc_part_cancelled(s,e) : (lc_part_cancelled(*s._CPLXptr,e) && lc_part_cancelled(*(s._CPLXptr+1),e)))
+      return 0;
+#endif
+    return s;
+  }
