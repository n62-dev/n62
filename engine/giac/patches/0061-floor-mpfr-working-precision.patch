# Upstream: giac 2.1.0 usual.cc _floor, its MPFR branch: the floor of a negative value is res-1 (res its truncation, real2int) unless is_zero(res-tmp), and is_zero of an MPFR value compares its double with epsilon, an absolute 1e-12 at any Digits (gen.cc is_zero). _ceil is -_floor(-x) and _round is floor(x+1/2), so every value within 1e-12 above an integer had that integer as its ceil, and a negative one within 1e-12 below as its floor, at Digits 12, 40 and 100 alike: ceil(pi*10^-13) = 0 (right 1), ceil(1-cos(10^-6)) = 0 (1), ceil(log10(10^12+1)) = 12 (13), floor(-pi*10^-13) = 0 (-1), round(-2.5-pi*10^-13) = -2 at Digits 40 (-3), ceil(sqrt(10^24+1)) = 10^12 (10^12+1), floor(-sqrt(10^30+1)) = -10^15 (-10^15-1); raw Giac after epsilon:=1e-30 gives the right ones. Now the value is its truncation only when res-tmp (exact, an MPFR difference of a float and its integer part) is 0 or below the rounding of tmp at its own precision (2^(16-prec) of |tmp|), so a value at rounding noise of an integer keeps it (floor(-(sin(1)^2+cos(1)^2)) = -1). is_zero and epsilon are not changed.
# Changed by Pascaline contributors, 2026-11-23
--- a/src/usual.cc
+++ b/src/usual.cc
@@ -7642,6 +7642,27 @@ namespace giac {
   gen apply_unit(const gen & args,const gen_op_context & f,GIAC_CONTEXT){
     return symbolic(at_unit,gen(makevecteur(f(args._SYMBptr->feuille[0],contextptr),args._SYMBptr->feuille[1]),_SEQ__VECT));  
   }
+  // N62 (G553): an MPFR tmp is its truncation res when res-tmp (exact: res is the integer part of tmp) is 0 or below
+  // the rounding of tmp at its own precision, 2^(16-prec) of |tmp|, never within is_zero's absolute epsilon (1e-12 at
+  // any Digits): ceil(pi*10^-13) was 0, floor(-pi*10^-13) 0, ceil(log10(10^12+1)) 12. A value at its rounding noise
+  // (sin(1)^2+cos(1)^2, exactly 1) keeps its integer.
+  static bool real_is_trunc(const gen & res,const gen & tmp,GIAC_CONTEXT){
+#if defined HAVE_LIBMPFR && !defined BF2GMP_H
+    gen d=res-tmp;
+    if (d.type!=_REAL || tmp.type!=_REAL)
+      return is_exactly_zero(d);
+    if (mpfr_nan_p(d._REALptr->inf) || mpfr_nan_p(tmp._REALptr->inf))
+      return false;
+    if (mpfr_zero_p(d._REALptr->inf))
+      return true;
+    if (mpfr_zero_p(tmp._REALptr->inf) || !mpfr_number_p(tmp._REALptr->inf))
+      return false;
+    return mpfr_get_exp(d._REALptr->inf)<=mpfr_get_exp(tmp._REALptr->inf)-long(mpfr_get_prec(tmp._REALptr->inf))+16;
+#else
+    return is_zero(res-tmp,contextptr);
+#endif
+  }
+
   gen _floor(const gen & args,GIAC_CONTEXT){
     if ( args.type==_STRNG && args.subtype==-1) return  args;
     if (is_equal(args))
@@ -7782,7 +7803,7 @@ namespace giac {
       }
 #endif
       gen res=real2int(tmp,contextptr);
-      if (is_strictly_positive(-tmp,contextptr) && !is_zero(res-tmp,contextptr))
+      if (is_strictly_positive(-tmp,contextptr) && !real_is_trunc(res,tmp,contextptr))
 	return res-1;
       return res;
     }
