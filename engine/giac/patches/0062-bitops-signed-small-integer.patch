       mpz_ior(e->z,e->z,*b._ZINTptr);
       return(e);
     case _ZINT__INT_:
       e = new ref_mpz_t;
-      mpz_set_ui(e->z,b.val);
+      mpz_set_si(e->z,b.val);
       mpz_ior(e->z,*a._ZINTptr,e->z);
