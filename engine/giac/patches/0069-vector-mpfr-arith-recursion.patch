+  // N62 (G802): sym_add, sym_sub, rdiv and _division (rpn.cc) bring an exact operand to the precision of an MPFR one with
+  // accurate_evalf and call themselves again when the result is_approx. For a vector is_approx is has_num_coeff (one float
+  // entry is enough), and accurate_evalf leaves a symbolic constant symbolic (exp(1) becomes exp(1.0)), so a vector holding
+  // a float and exp(1), sqrt(2), ln(2) or sin(1) came back as it was and the call repeated until the stack overflowed:
+  // [0.1,exp(1)]/2, [0.1,exp(1)]+2.0, 2.0-[0.1,exp(1)] at Digits > 14 (a typed decimal is an MPFR float there), so
+  // exp(approx([[0.1,exp(1),pi],[5,2,7],[exp(1),7,9.81]]/10^4)) killed the engine. A vector counts as converted only when
+  // every entry is a number; otherwise the callers go on with has_evalf's value, as for a symbolic scalar.
+  bool accurate_evalf_is_number(const gen & g){
+    return g.is_approx() && (g.type!=_VECT || is_fully_numeric(g));
+  }
+
   gen evalf(const gen & e,int level,const context * contextptr){ 
     return e.evalf(level,contextptr); 
   }
@@ -5153,7 +5164,7 @@ namespace giac {
