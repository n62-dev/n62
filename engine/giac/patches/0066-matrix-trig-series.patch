+  // N62 (G792): true when g holds a float (a double, an MPFR real, a giac float; a complex with one as a part).
+  static bool numeric_matrix_has_float(const gen & g){
+    switch (g.type){
+    case _DOUBLE_: case _REAL: case _FLOAT_:
+      return true;
+    case _CPLX:
+      return numeric_matrix_has_float(*g._CPLXptr) || numeric_matrix_has_float(*(g._CPLXptr+1));
+    case _VECT: {
+      const_iterateur it=g._VECTptr->begin(),itend=g._VECTptr->end();
+      for (;it!=itend;++it){
+	if (numeric_matrix_has_float(*it))
+	  return true;
+      }
+      return false;
+    }
+    default:
+      return false;
+    }
+  }
+  // N62 (G792): a square matrix of numbers (integers, fractions and pi admitted) with at least one float entry: sin, cos,
+  // sinh and cosh take numeric_matrix_trig for it, an exact matrix keeps analytic_apply.
+  static bool is_float_squarematrix(const gen & e){
+    return is_squarematrix(e) && is_fully_numeric(e,num_mask_withint|num_mask_withfrac) && numeric_matrix_has_float(e);
+  }
+  // N62 (G792): for a matrix of floats whose doubles are all 0 (numeric_matrix_exp_scan's nrm 0), log2 of a bound of
+  // max |re|+|im| over the entries, and nonzero true when an entry is not exactly 0: an MPFR part x has |x| < 2^exp(x),
+  // any other part whose double is 0 is below 2^-1074.
+  static double numeric_matrix_tiny_log2(const gen & g,bool & nonzero){
+    double res=-1e9;
+    if (g.type==_VECT){
+      const_iterateur it=g._VECTptr->begin(),itend=g._VECTptr->end();
+      for (;it!=itend;++it)
+	res=std::max(res,numeric_matrix_tiny_log2(*it,nonzero));
+      return res;
+    }
+    for (int k=0;k<2;++k){
+      const gen & p=g.type==_CPLX?*(g._CPLXptr+k):(k?gen(0):g);
+      if (is_exactly_zero(p))
+	continue;
+      nonzero=true;
+      double l=-1074;
+#ifdef HAVE_LIBMPFR
+      if (p.type==_REAL)
+	l=double(mpfr_get_exp(p._REALptr->inf));
+#endif
+      res=std::max(res,l+1); // |re|+|im| below twice the larger part
+    }
+    return res;
+  }
+  // N62 (G792): sin, cos (hyp false) or sinh, cosh (hyp true) of a numeric square matrix, the odd function when odd, by
+  // numeric_matrix_exp's scaling and squaring (patch 0063). Stock sent a float matrix to analytic_apply, which
+  // diagonalises over the complex eigenvalues and transforms back: the eigenvectors' round-off stayed as imaginary noise
+  // in a real result (sin(evalf([[0,1],[-1,0]])) = [[2.998e-15*i,1.17520119364],[-1.17520119364,2.998e-15*i]] at Digits
+  // 12), and at Digits 40 the entries came back as doubles with that noise (cos(evalf([[1,2],[3,4]])) printed 14 digits).
+  // Now e (in radians) is divided by 2^s as in numeric_matrix_exp; the series of the even part C (cos or cosh) and of the
+  // odd part S (sin or sinh) run at the same bits until the same bound, and the double-angle rules S'=2*S*C, C'=C^2-S^2
+  // (cos) or C^2+S^2 (cosh) run s times (C and S are series in e, so they commute); the result is rounded back to the
+  // entries' precision. A real matrix stays real, and sinh is never (e^M-e^-M)/2, which cancels where an entry is small
+  // (stock's diagonal path gave sinh(evalf([[1,0],[0,10^-20]])) its 1e-20). A matrix whose entries are all exactly 0 gives
+  // the exact identity (cos, cosh) or the exact zero matrix (sin, sinh), as exp does; one whose entries are below the
+  // double range runs the series with a bound from their MPFR exponents.
+  static gen numeric_matrix_trig(const gen & e0,bool hyp,bool odd,GIAC_CONTEXT){
+    gen e=evalf(e0,1,contextptr);
+    if (e.type!=_VECT)
+      return gensizeerr(contextptr);
+    if (!hyp && !angle_radian(contextptr))
+      e=e*evalf(angle_degree(contextptr)?deg2rad_g:grad2rad_g,1,contextptr);
+    if (e.type!=_VECT)
+      return gensizeerr(contextptr);
+    int n=int(e._VECTptr->size()),prec=0;
+    double nrm=0;
+    bool finite=true;
+    numeric_matrix_exp_scan(e,nrm,prec,finite,contextptr);
+    if (!finite)
+      return gensizeerr(gettext("a matrix entry is not a finite number"));
+    int s=0;
+    double l2nrm; // log2 of N/2^s, N = n*max(|re|+|im|) over the entries
+    if (nrm==0){
+      // the scan's doubles are all 0: the exact identity or zero matrix only when every entry is exactly 0; an MPFR entry
+      // below the double range (10^-400 at Digits 40) reads as a double 0 too, and its bound comes from its exponent
+      // (sin(evalf([[10^-400,0],[0,10^-400]])) at Digits 40 is that matrix, not the exact zero matrix)
+      bool nonzero=false;
+      l2nrm=numeric_matrix_tiny_log2(e,nonzero);
+      if (!nonzero)
+        return odd?gen(vecteur(n,gen(vecteur(n,0))),_MATRIX__VECT):midn(n);
+      l2nrm+=std::log(double(n))/std::log(2.0);
+    }
+    else {
+      nrm*=n;
+      for (;nrm>0.5;++s)
+	nrm/=2;
+      l2nrm=std::log(nrm)/std::log(2.0);
+    }
+    int nbits=giacmax(prec,53)+s+16;
+#ifdef HAVE_LIBMPFR
+    e=accurate_evalf(e,nbits);
+#endif
+    if (s)
+      e=e*accurate_evalf(inv(pow(plus_two,s),contextptr),nbits);
+    gen C=accurate_evalf(midn(n),nbits),S(e),term(e);
+    double lg=l2nrm; // lg: log2 of the bound of the term in `term`, as in numeric_matrix_exp
+    for (int j=2;;++j){
+      control_c();
+      if (interrupted)
+	return gensizeerr(gettext("Stopped by user interruption."));
+      lg+=l2nrm-std::log(double(j))/std::log(2.0);
+      // the rest of each series is below twice this bound (N/2^s <= 1/2); the bound is taken relative to N/2^s, not to 1,
+      // because the odd part S is of N's size: sin of a matrix of 10^-400 at Digits 1000 needs its M^3/6
+      if (lg<l2nrm-nbits-2)
+	break;
+      term=numeric_matrix_exp_mult(term,e)*accurate_evalf(inv(gen(j),contextptr),nbits);
+      // e^j/j! goes to C (j even) or S (j odd); cos and sin alternate: + at j = 0 and 1 mod 4
+      bool plus=hyp || j%4<2;
+      if (j%2==0)
+	C=plus?C+term:C-term;
+      else
+	S=plus?S+term:S-term;
+    }
+    for (int k=0;k<s;++k){
+      control_c();
+      if (interrupted)
+	return gensizeerr(gettext("Stopped by user interruption."));
+      gen SC=numeric_matrix_exp_mult(S,C),CC=numeric_matrix_exp_mult(C,C),SS=numeric_matrix_exp_mult(S,S);
+      S=SC+SC;
+      C=hyp?CC+SS:CC-SS;
+    }
+    gen res=odd?S:C;
+#ifdef HAVE_LIBMPFR
+    res=prec?accurate_evalf(res,prec):numeric_matrix_exp_double(res,contextptr);
+#endif
+    return res;
+  }
